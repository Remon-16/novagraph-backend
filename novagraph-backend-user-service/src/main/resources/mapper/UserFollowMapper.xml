<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tech.novagraphbackenduserservice.infrastructure.mapper.UserFollowMapper">

    <resultMap id="BaseResultMap" type="com.tech.novagraphbackendmodel.user.entity.UserFollow">
            <id property="id" column="id" />
            <result property="userId" column="userId" />
            <result property="followingId" column="followingId" />
            <result property="followerId" column="followerId" />
            <result property="editTime" column="editTime" />
            <result property="createTime" column="createTime" />
            <result property="updateTime" column="updateTime" />
            <result property="isDelete" column="isDelete" />
    </resultMap>

    <sql id="Base_Column_List">
        id,userId,followingId,followerId,editTime,createTime,
        updateTime,isDelete
    </sql>
    <insert id="batchIgnoreInsert">
        INSERT IGNORE INTO user_follow (
        userId,
        followingId,
        ) VALUES
        <foreach collection="userFollows" item="item" separator=",">
        (
        #{item.userId},
        #{item.followingId},
        )
        </foreach>
    </insert>
</mapper>

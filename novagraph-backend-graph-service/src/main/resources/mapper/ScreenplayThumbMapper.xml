<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tech.novagraphbackendgraphservice.infrastructure.mapper.ScreenplayThumbMapper">

    <resultMap id="BaseResultMap" type="com.tech.novagraphbackendmodel.graph.entity.ScreenplayThumb">
            <id property="id" column="id" />
            <result property="userId" column="userId" />
            <result property="screenplayId" column="screenplayId" />
            <result property="createTime" column="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id,userId,screenplayId,createTime
    </sql>
    <insert id="batchIgnoreInsert">
        INSERT IGNORE INTO screenplay_thumb (
        userId,
        screenplayId
        ) VALUES
        <foreach collection="thumbs" item="item" separator=",">
            (
            #{item.userId},
            #{item.screenplayId},
            )
        </foreach>
    </insert>
</mapper>

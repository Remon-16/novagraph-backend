<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tech.novagraphbackendgraphservice.infrastructure.mapper.ScreenplayMapper">

    <resultMap id="BaseResultMap" type="com.tech.novagraphbackendmodel.graph.entity.Screenplay">
            <id property="id" column="id" />
            <result property="name" column="name" />
            <result property="introduction" column="introduction" />
            <result property="category" column="category" />
            <result property="tags" column="tags" />
            <result property="cover" column="cover" />
            <result property="plotTree" column="plotTree" />
            <result property="userId" column="userId" />
            <result property="visibility" column="visibility" />
            <result property="reviewStatus" column="reviewStatus" />
            <result property="reviewMessage" column="reviewMessage" />
            <result property="reviewerId" column="reviewerId" />
            <result property="reviewTime" column="reviewTime" />
            <result property="editTime" column="editTime" />
            <result property="createTime" column="createTime" />
            <result property="updateTime" column="updateTime" />
            <result property="isDelete" column="isDelete" />
    </resultMap>

    <sql id="Base_Column_List">
        id,name,introduction,category,tags,cover,
        plotTree,userId,editTime,createTime,updateTime,
        isDelete,visibility,reviewStatus,reviewMessage,reviewerId,reviewTime
    </sql>

    <sql id="selectScreenplayWithStats">
        SELECT
            s.id,
            s.name,
            s.introduction,
            s.category,
            s.tags,
            s.cover,
            s.plotTree,
            s.userId,
            s.editTime,
            s.createTime,
            s.updateTime,
            st.thumbCount,
            st.favoriteCount,
            st.playCount
        FROM
            screenplay s
                LEFT JOIN
            screenplay_statistics st ON s.id = st.screenplayId
    </sql>

    <select id="selectScreenplayWithStatsPage" resultType="com.tech.novagraphbackendmodel.graph.entity.ScreenplayWithStats">
        <include refid="selectScreenplayWithStats"/>
        <where>
            s.isDelete = 0

            <if test="request.id != null">
                AND s.id = #{request.id}
            </if>

            <if test="request.visibility != null">
                AND s.visibility = #{request.visibility}
            </if>

            <if test="request.reviewStatus != null">
                AND s.reviewStatus = #{request.reviewStatus}
            </if>

            <if test="request.name != null and request.name != ''">
                AND s.name LIKE CONCAT('', #{request.name}, '%')
            </if>

            <if test="request.category != null and request.category != ''">
                AND s.category = #{request.category}
            </if>

            <if test="request.startEditTime != null">
                AND s.createTime &gt;= #{request.startEditTime}
            </if>
            <if test="request.endEditTime != null">
                AND s.createTime &lt;= #{request.endEditTime}
            </if>

            <if test="request.tags != null and request.tags.size() > 0">
                <foreach collection="request.tags" item="tag" >
                    AND s.tags LIKE CONCAT('%', #{tag}, '%')
                </foreach>
            </if>
        </where>

        <if test="request.sortField != null and request.sortField != ''">
            ORDER BY s.${request.sortField}
            <if test="request.sortOrder != null and request.sortOrder != ''">
                <choose>
                    <when test="request.sortOrder == 'ascend'">ASC</when>
                    <otherwise>DESC</otherwise>
                </choose>
            </if>
        </if>
    </select>

    <select id="selectScreenplayWithStatsById"
            resultType="com.tech.novagraphbackendmodel.graph.entity.ScreenplayWithStats">
        <include refid="selectScreenplayWithStats"/>
        <where>
            s.isDelete = 0
            AND s.id = #{screenplayId}
        </where>
    </select>
</mapper>
